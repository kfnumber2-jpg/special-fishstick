# ============================================================
# Stripe configuration — copy this file to ".env" and fill in.
#   cp .env.example .env
# Never commit the real ".env" (it's gitignored).
# ============================================================

# Your Stripe SECRET key. Find it at https://dashboard.stripe.com/apikeys
# (it begins with "sk" + "_test_" in test mode, or "_live_" in live mode).
STRIPE_SECRET_KEY=PASTE_YOUR_STRIPE_SECRET_KEY_HERE

# Price IDs (each begins with "price" + "_") for each package.
# Create Products + Prices at https://dashboard.stripe.com/products
#   - Rookie / Varsity / Elite: create them as RECURRING (monthly) prices.
#   - Full Course: create it as a ONE-TIME price.
PRICE_ROOKIE=PASTE_ROOKIE_PRICE_ID_HERE
PRICE_VARSITY=PASTE_VARSITY_PRICE_ID_HERE
PRICE_ELITE=PASTE_ELITE_PRICE_ID_HERE
PRICE_FULL_COURSE=PASTE_FULL_COURSE_PRICE_ID_HERE

# Optional: webhook signing secret (starts with whsec_...) for order
# fulfillment. Get it from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=

# Optional: the public URL of your site. In dev this is detected from the
# request automatically; set it in production (e.g. https://yourdomain.com).
PUBLIC_URL=

# Port the checkout server listens on (default 8787).
PORT=8787
